# B3JS Web3 — Environment Configuration
#
# Copy this file to .env and set the values for your environment.
# Do NOT commit .env to source control.

# QRL Miner WebSocket endpoint
QRL_MINER_WS_URL=ws://localhost:8000/ws

# Quai GPU Miner hardware polling endpoint
QUAI_MINER_API_URL=http://localhost:8081/api/hardware

# Privy App ID (for authentication, when implemented)
PRIVY_APP_ID=your-privy-app-id-here
